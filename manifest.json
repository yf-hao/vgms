{
  "manifest_version": 3,
  "name": "VGMS填报助手",
  "version": "0.8.0",
  "description": "VGMS 登录与表单填报助手。",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://vgms.fanyu.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VGMS填报助手"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["https://vgms.fanyu.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://vgms.fanyu.com/*"],
      "js": ["floating-panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/*"],
      "js": ["login.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/admin/*"],
      "js": [
        "topic-review-settings.js",
        "topic-review-dialog.js",
        "topic-review-form.js",
        "topic-review-runner.js",
        "topic-review-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/admin/*"],
      "js": [
        "taskbook-store.js",
        "taskbook-form.js",
        "taskbook-runner.js",
        "taskbook-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/*"],
      "js": ["storage-client.js", "content.js", "batch.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
