{
  "manifest_version": 3,
  "name": "VGMS填报助手",
  "version": "0.8.0",
  "description": "VGMS 登录与表单填报助手。",
  "key": "",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://vgms.fanyu.com/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "VGMS填报助手"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup/popup.html"],
      "matches": ["https://vgms.fanyu.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://vgms.fanyu.com/*"],
      "js": ["content/floating-panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/*"],
      "js": ["content/login.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/admin/*"],
      "js": [
        "shared/topic-review-settings.js",
        "content/topic-review/topic-review-dialog.js",
        "content/topic-review/topic-review-form.js",
        "content/topic-review/topic-review-runner.js",
        "content/topic-review/topic-review-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/admin/*"],
      "js": [
        "shared/taskbook-store.js",
        "content/taskbook/taskbook-form.js",
        "content/taskbook/taskbook-runner.js",
        "content/taskbook/taskbook-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vgms.fanyu.com/*"],
      "js": [
        "content/shared/storage-client.js",
        "content/subject/content.js",
        "content/subject/batch.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
